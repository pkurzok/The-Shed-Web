---
import { content, localePath, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  // The same page in the other language, when there is one.
  language?: { label: string; lang: Lang; href: string };
}

const { lang, language } = Astro.props;
const { footer } = content[lang];
// Pages of the site stay in the language; outbound links stay as they are.
const resolve = (href: string) => (href.startsWith('/') ? localePath(lang, href) : href);
---

<footer class="site-footer">
  <div class="container">
    <p>{footer.copyright}</p>
    <div class="footer-links">
      {
        footer.links.map((entry) => (
          <a href={resolve(entry.href)}>{entry.label}</a>
        ))
      }
      {
        language && (
          <a href={language.href} lang={language.lang} hreflang={language.lang}>
            {language.label}
          </a>
        )
      }
    </div>
  </div>
</footer>
