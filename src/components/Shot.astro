---
// One screenshot of src/assets/images/screenshots/<lang>/, as WebP in three widths.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { Lang, ScreenshotFile } from '../data/site';

interface Props {
  lang: Lang;
  file: ScreenshotFile;
  alt: string;
  // The width the image takes in the layout, for the browser's choice of file.
  sizes: string;
  // The hero shot loads at once; every other one when it scrolls into view.
  eager?: boolean;
  class?: string;
}

const { lang, file, alt, sizes, eager = false, class: className } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/images/screenshots/*/*.png', { eager: true });
const image = images[`../assets/images/screenshots/${lang}/${file}.png`]?.default;
if (!image) throw new Error(`Screenshot ${lang}/${file}.png is missing; run scripts/import-assets.sh`);
---

<Picture
  src={image}
  alt={alt}
  formats={['webp']}
  widths={[640, 1100, 1600]}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  class={className}
  data-shot={`${lang}/${file}`}
/>
