---
import { content, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { facts } = content[Astro.props.lang];
---

<section class="facts">
  <div class="container">
    <ul>
      {
        facts.map((fact) => (
          <li class="fact">
            <b>{fact.value}</b>
            <span>{fact.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
