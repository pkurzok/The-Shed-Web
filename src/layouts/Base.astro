---
import '@fontsource-variable/archivo/wdth.css';
import { getImage } from 'astro:assets';
import appIcon from '../assets/images/app-icon.png';
import socialEn from '../assets/images/og/en.png';
import socialDe from '../assets/images/og/de.png';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { app, content, langs, locales, translatedPath, type Lang } from '../data/site';
import '../styles/site.css';

interface Props {
  lang?: Lang;
  title: string;
  description: string;
  // Path of the page with leading and trailing slash, e.g. "/privacy/". Without it the page
  // gets neither a canonical link nor og:url (the 404 page has no address of its own).
  path?: string;
  noindex?: boolean;
  // false for a page that exists once for all languages: no hreflang links, no language link.
  alternate?: boolean;
}

const { lang = 'en', title, description, path, noindex = false, alternate = true } = Astro.props;

const canonical = path ? new URL(path, Astro.site).href : undefined;

// The page in every language, for search engines; x-default is the English one. Only once a
// second language exists.
const translated = alternate && path !== undefined && langs.length > 1;
const alternates = translated
  ? langs.map((other) => ({ lang: other, href: new URL(translatedPath(path, lang, other), Astro.site).href }))
  : [];
// The link to the same page in the other language, for the header and the footer.
const { otherLanguage } = content[lang];
const language =
  translated && langs.includes(otherLanguage.lang)
    ? { ...otherLanguage, href: translatedPath(path, lang, otherLanguage.lang) }
    : undefined;

// PNG on purpose: getImage would produce WebP by default.
const favicon = await getImage({ src: appIcon, width: 64, height: 64, format: 'png' });
const touchIcon = await getImage({ src: appIcon, width: 180, height: 180, format: 'png' });
// The captioned store screenshot, opaque, for link previews.
const social = await getImage({
  src: { en: socialEn, de: socialDe }[lang],
  width: 1200,
  format: 'jpeg',
  quality: 80,
});
const socialImage = new URL(social.src, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#121316" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={app.author} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((entry) => <link rel="alternate" hreflang={entry.lang} href={entry.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <meta property="og:site_name" content={app.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locales[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={String(social.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(social.attributes.height ?? 900)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {app.status !== 'unreleased' && <meta name="apple-itunes-app" content={`app-id=${app.appStoreId}`} />}
  </head>
  <body>
    <a href="#main" class="skip-link">{content[lang].skipLink}</a>
    <Header lang={lang} path={path} language={language} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} language={language} />
  </body>
</html>
